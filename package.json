{
  "name": "@abo/sweepsign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write app src lib scripts e2e",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@next/env": "16.3.6",
    "@revenuecat/purchases-js": "^1.63.1",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.28.9",
    "lucide-react": "1.47.0",
    "motion": "^12.23.24",
    "next": "^16.3.6",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "jsdom": "28.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "5.0.1"
  }
}
