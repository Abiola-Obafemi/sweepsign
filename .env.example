# Copy to .env for local development. Never commit a real secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Add the eventual custom domain host here. Local hosts and *.vercel.app are
# already allowlisted by the dynamic Better Auth base URL configuration.
BETTER_AUTH_ALLOWED_HOSTS=
# Required in every deployed Vercel environment. Use Supabase's pooled
# Postgres connection string; do not expose a service-role key in this app.
DATABASE_URL=
# Vercel's Supabase integration provides POSTGRES_URL instead; SweepSign accepts
# either name and prefers DATABASE_URL when both are present.
POSTGRES_URL=
# Local and E2E use a deterministic SQLite file only when DATABASE_URL is unset.
SWEEPSIGN_DB_PATH=.data/sweepsign.sqlite
# RevenueCat Web Billing public Test Store key. Omit it to keep billing unavailable and honest.
NEXT_PUBLIC_REVENUECAT_PUBLIC_API_KEY=
# Transactional email remains disabled until both values are configured in the
# environment and the sending domain is verified with Resend. Never expose the
# API key to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SweepSign <auth@notify.sweepsign.com>"
RESEND_REPLY_TO=support@sweepsign.com
# Optional public support inbox. Omit it to keep the existing ABØ contact path.
SWEEPSIGN_SUPPORT_EMAIL=support@sweepsign.com
# Optional Google Search Console HTML-tag value (the content value only).
GOOGLE_SITE_VERIFICATION=
